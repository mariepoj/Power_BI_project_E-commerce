	partition Geolocation_Deduplicated = m
		mode: import
		source =
				let
				    Source = Geolocation,
				    Grouped = Table.Group(
				        Source,
				        {"geolocation_zip_code_prefix"},
				        {
				            {"Avg_Lat", each List.Average([geolocation_lat]), type number},
				            {"Avg_Lng", each List.Average([geolocation_lng]), type number},
				            {"State", each List.First([geolocation_state]), type text},
				            {"City", each List.First([geolocation_city]), type text}
				        }
				    )
				in
				    Grouped

