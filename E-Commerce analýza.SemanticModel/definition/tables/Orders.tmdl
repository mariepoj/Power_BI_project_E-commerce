table Orders
	lineageTag: bfa6d0f8-807c-453e-94ac-f9c2d57b23df

	measure 'Total Order' = COUNTROWS(Orders)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0325836b-53fc-4ade-9855-da46835c1bc0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Order' = DIVIDE([Total Revenue], [Total Order])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: bd587cba-70b5-496d-b918-b2aa19f2d17b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Review' = AVERAGE(Order_Reviews[review_score])
		lineageTag: 15eccbec-61a7-4f46-a960-8866f791bbb2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Delivery Time (days)' = AVERAGE(Orders[delivery_days])
		lineageTag: 4804c0ad-f69e-4de7-bb4c-0b5c69d52d0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' =
			
			SUM(Order_Items[price]) + SUM(Order_Items[freight_value])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 78d00f1a-bc95-49a6-a69a-7b150d05a2e0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Review Score' =
			
			AVERAGEX(
			    CALCULATETABLE(
			        Order_Reviews,
			        RELATEDTABLE(Order_Items)
			    ),
			    Order_Reviews[review_score]
			)
		lineageTag: e7af7700-968d-40f0-a374-3b3ec4054258

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Delivery Time' =
			
			CALCULATE(
			    AVERAGE(Orders[delivery_days]),
			    NOT(ISBLANK(Orders[delivery_days]))
			)
		lineageTag: c8fd0e54-cb3e-4d5b-bd1a-8df53d43a8e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Estimated Delivery Time' = ```
			
			AVERAGE(Orders[estimated_delivery_days])
			
			```
		lineageTag: d1755b47-7e7d-4cac-8bf9-aec1fe22dc22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Delay' =
			
			AVERAGE(Orders[delay_days])
		lineageTag: 65b90bfb-56a4-48af-8447-62cba1b20dd7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Deliveries %' =
			
			DIVIDE(
			    SUM(Orders[is_late]),
			    COUNTROWS(Orders)
			)
		lineageTag: b1b76e9c-eae0-42cb-9339-62932e7f0cd3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Growth' =
			
			DISTINCTCOUNT(Orders[customer_id])
		formatString: 0
		lineageTag: e3f998ee-832a-41a1-9209-51d0fbd795e0

	measure 'Customer Growth Cumulative' =
			
			CALCULATE(
			    [Customer Growth],
			    FILTER(
			        ALL(Calendar[Date]),
			        Calendar[Date] <= MAX(Calendar[Date])
			    )
			)
		formatString: 0
		lineageTag: 1afbabcd-f848-4e6c-bd26-5745266f86d9

