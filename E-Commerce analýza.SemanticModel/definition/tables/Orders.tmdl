	column customer_unique_id = ```
			
			RELATED(Customers[customer_unique_id])
			
			```
		lineageTag: 09b413cc-1630-4b46-9812-e7de6fafb4e4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column delivery_days =
			
			DATEDIFF(
			    Orders[order_purchase_timestamp],
			    Orders[order_delivered_customer_date],
			    DAY
			)
		formatString: 0
		lineageTag: bbee4911-532d-4893-8fd8-23d419f4460d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Orders","TableItemName":"Delivery Days (Bins)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column estimated_delivery_days =
			
			DATEDIFF(
			    Orders[order_purchase_timestamp],
			    Orders[order_estimated_delivery_date],
			    DAY
			)
		formatString: 0
		lineageTag: fbbdd28b-da13-4aa5-b6aa-97697749d232
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column delay_days =
			
			DATEDIFF(
			    Orders[order_estimated_delivery_date],
			    Orders[order_delivered_customer_date],
			    DAY
			)
		formatString: 0
		lineageTag: c76733d5-eb3f-4c4b-b3de-528404793115
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column is_late =
			
			IF(
			    Orders[order_delivered_customer_date] > Orders[order_estimated_delivery_date],
			    1,
			    0
			)
		formatString: 0
		lineageTag: a0bfae9e-f1f7-435b-b8d1-4051accfa374
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Delivery Days (Bins)' =
			IF(
				ISBLANK('Orders'[delivery_days]),
				BLANK(),
				INT('Orders'[delivery_days])
			)
		formatString: 0
		lineageTag: 06ced29b-faf6-4bd3-b3cb-e422b15d4710
		summarizeBy: none

