	column 'Order Count' = ```
			
			CALCULATE(
			    COUNTROWS(Orders),
			    FILTER(
			        Orders,
			        Orders[customer_unique_id] = Customers[customer_unique_id]
			    )
			)
			
			```
		formatString: 0
		lineageTag: 199b9d7b-09bc-405e-86fa-e8e2cadb193a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Customers = m
		mode: import
