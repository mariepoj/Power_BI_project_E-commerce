table Customers
	lineageTag: 12814f71-43ed-4d39-ac17-e6706bc71494

	measure 'Total Customers' = ```
			DISTINCTCOUNT(Customers[customer_id])
			
			```
		formatString: 0
		lineageTag: 208c04c3-802a-4391-868d-61793cbdcbc2

	measure 'Returning Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(Customers[customer_unique_id]),
			    FILTER(Customers, Customers[Order Count] > 1)
			)
		formatString: 0
		lineageTag: a9622b37-d35b-4152-8ce6-3765fdab4bff

	measure 'New Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(Customers[customer_unique_id]),
			    FILTER(Customers, Customers[Order Count] = 1)
			)
		formatString: 0
		lineageTag: 6c780849-4615-4517-acaf-04acd37e2fe4

	measure 'Avg Orders per Customer' = ```
			
			AVERAGEX(Customers, Customers[Order Count])
			
			```
		lineageTag: 5c7bc497-ec40-42a4-8f72-89b243825d4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

